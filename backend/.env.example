NODE_ENV=development
PORT=3000

# Conexión a MySQL 8.0+ (usuario con privilegios sobre la base cafe_itsh)
DATABASE_URL=mysql://cafe_admin:cafeContra@127.0.0.1:3306/cafe_itsh

# Autenticación
JWT_SECRET=cambia-esta-clave-por-una-segura-en-produccion
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (frontend de Vite)
CORS_ORIGIN=http://localhost:5173

# Pagos (dev: proveedor simulado, sin clave real)
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
# Anticipación mínima para pedidos anticipados (minutos)
MIN_LEAD_MINUTES=10

# Notificaciones por correo (dev: console; fail: simula un error para probar reintentos)
MAIL_PROVIDER=console
MAIL_FROM=Cafetería ITSH <no-reply@itsh.edu.mx>
# Reintentos máximos de envío y frecuencia del worker de notificaciones (ms; 0 desactiva el worker)
NOTIFICACION_MAX_INTENTOS=5
NOTIFICACION_POLL_MS=15000

# Cuentas iniciales del seed (solo desarrollo)
SEED_ADMIN_EMAIL=admin@itsh.edu.mx
SEED_ADMIN_PASSWORD=admin123
SEED_CAJERO_EMAIL=caja@itsh.edu.mx
SEED_CAJERO_PASSWORD=caja123
SEED_COCINERO_EMAIL=cocina@itsh.edu.mx
SEED_COCINERO_PASSWORD=cocina123
